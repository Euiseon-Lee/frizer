# Copy to .env and enter your local database password. Never commit .env.
# Compose and the Spring local profile read .env from the project root.
FRIZER_DB_PORT=5432
FRIZER_DB_PASSWORD=
FRIZER_APP_PORT=8080
# Used once to initialize the database account (10+ characters).
FRIZER_LOGIN_USERNAME=frizer
FRIZER_LOGIN_PASSWORD=
