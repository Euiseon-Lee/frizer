# Gradle cache and generated build output
.gradle/
build/
out/

# Machine-specific JDK path (shared build settings belong in build.gradle)
/gradle.properties

# Personal IDE settings (IntelliJ IDEA / Eclipse)
.idea/
.run/*.local.run.xml
*.iml
.classpath
.project
.settings/

# Local environment values; keep the safe setup example in Git
.env
.env.*
!.env.example

# Runtime logs and OS metadata
*.log
.DS_Store
Thumbs.db

# Documentation screenshots/review sheets are temporary; app photos belong in static/assets.
/docs/**/*.png
/docs/**/*.jpg
/docs/**/*.jpeg
.neon
node_modules/
# Local Neon agent tooling (not application deployment inputs)
.agents/skills/
skills-lock.json
